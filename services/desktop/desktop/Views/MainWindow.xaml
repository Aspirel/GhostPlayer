<Window x:Class="desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#1E1E1E">
            <Button Content="Home"
                    Margin="10"
                    Command="{Binding ShowHomeCommand}" />
            
            <Button Content="Youtube"
                    Margin="10"
                    Command="{Binding ShowYoutubeCommand}" />

            <Button Content="Twitch"
                    Margin="10"
                    Command="{Binding ShowTwitchCommand}" />

            <Button Content="Settings"
                    Margin="10"
                    Command="{Binding ShowSettingsCommand}" />

            <Button Content="History"
                    Margin="10"
                    Command="{Binding ShowHistoryCommand}" />

            <Button Content="Local Files"
                    Margin="10"
                    Command="{Binding ShowLocalFilesCommand}" />       
        </StackPanel>

        <!-- Main content -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}" />
    </Grid>
</Window>
