<Window x:Class="desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop"
        xmlns:view="clr-namespace:desktop.Views"
        xmlns:vm="clr-namespace:desktop.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800"
		Background="#1E1E1E">

	<Window.Resources>
		<DataTemplate DataType="{x:Type vm:YoutubeViewModel}">
			<view:YoutubeView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type vm:HomeViewModel}">
			<view:HomeView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type vm:TwitchViewModel}">
			<view:TwitchView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type vm:SettingsViewModel}">
			<view:SettingsView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type vm:HistoryViewModel}">
			<view:HistoryView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type vm:LocalFilesViewModel}">
			<view:LocalFilesView />
		</DataTemplate>
	</Window.Resources>
	
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
		<StackPanel Grid.Column="0" Background="#1E1E1E">
			<Button Content="Home" Margin="10" Command="{Binding ShowHomeCommand}" />
			<Button Content="Youtube" Margin="10" Command="{Binding ShowYoutubeCommand}" />
			<Button Content="Twitch" Margin="10" Command="{Binding ShowTwitchCommand}" />
			<Button Content="Settings" Margin="10" Command="{Binding ShowSettingsCommand}" />
			<Button Content="History" Margin="10" Command="{Binding ShowHistoryCommand}" />
			<Button Content="Local Files" Margin="10" Command="{Binding ShowLocalFilesCommand}" />
		</StackPanel>		

        <!-- Main content -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}" />
    </Grid>
</Window>
